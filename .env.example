# Copy to .env and fill in. Never commit .env. No quotes around values.

# Optional: DeepL API key – enables reference-translation suggestions (INFO only)
DEEPL_API_KEY=

# Optional: local LanguageTool server used by the grammar check
LT_URL=http://localhost:8081/v2

# Optional: LanguageTool install folder, used by MASTER_RUN.bat to start the server
LT_DIR=C:\LanguageTool\LanguageTool-6.4
